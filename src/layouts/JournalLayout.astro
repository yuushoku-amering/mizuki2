---
import type { MarkdownHeading } from "astro";
import ConfigCarrier from "@components/misc/ConfigCarrier.astro";
import MusicPlayer from "@components/widgets/music-player/MusicPlayer.svelte";
import FloatingControls from "@components/control/FloatingControls.astro";
import Pio from "@components/features/pio/Pio.astro";
import { siteConfig, profileConfig, pioConfig } from "@/config";
import "../styles/main.css";
import "../styles/variables.styl";
import "../styles/markdown.css";
import "../styles/expressive-code.css";
import "../styles/fancybox-custom.css";
import "../styles/journal.css";

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
  headings?: MarkdownHeading[];
  postSlug?: string;
  lang?: string;
  setOGTypeArticle?: boolean;
  coverImage?: string;
  banner?: string;
  publishedDate?: Date;
  category?: string;
  wordCount?: number;
}
const {title = "首页", description = "社会学学习、用户研究、数据分析项目与个人兴趣记录。", home = false, headings = [], postSlug, setOGTypeArticle = false, coverImage} = Astro.props;
const pathname = Astro.url.pathname;
const isPost = Boolean(postSlug);
const nav = [{href:"/",label:"首页"},{href:"/archive/",label:"文章"},{href:"/projects/",label:"项目"},{href:"/albums/",label:"相册"},{href:"/about/",label:"关于"}];
const more = [{href:"/skills/",label:"技能"},{href:"/timeline/",label:"时间线"},{href:"/resume/",label:"简历"},{href:"/portfolio/",label:"作品集"},{href:"/friends/",label:"友链与资源"},{href:"/anime/",label:"追番"},{href:"/games/",label:"游戏"},{href:"/ai-tools/",label:"AI 工具"},{href:"/devices/",label:"设备"}];
const active = (href: string) => href === "/" ? pathname === "/" : pathname.startsWith(href) || (href === "/archive/" && isPost);
const canonical = new URL(pathname, Astro.site || siteConfig.siteURL);
const pageTitle = `${title} · ${siteConfig.title}`;
---
<!doctype html>
<html lang="zh-CN" data-journal="true" style="--hue:345">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profileConfig.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={setOGTypeArticle ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    {coverImage && <meta property="og:image" content={new URL(coverImage, canonical)} />}
    <slot name="head" />
  </head>
  <body class="theme-a journal-site">
    <ConfigCarrier />
    <a class="skip" href="#main">跳到正文</a>
    <header class="site-header" data-pagefind-ignore>
      <a class="brand" href="/"><span class="brand-mark">雨</span><span>{siteConfig.title}<small>YUUSHOKU AMERING</small></span></a>
      <nav aria-label="主导航">
        {nav.map(item => <a href={item.href} aria-current={active(item.href) ? "page" : undefined}>{item.label}</a>)}
        <details class="more-nav"><summary>更多 <span aria-hidden="true">⌄</span></summary><div class="more-panel">{more.map(item => <a href={item.href}>{item.label}<span aria-hidden="true">↗</span></a>)}</div></details>
      </nav>
      <div class="header-tools">
        <button data-search aria-label="搜索站内内容">⌕ <span>搜索</span></button>
        <button class="motion" aria-pressed="false" aria-label="暂停画面动效">◌ <span>动效</span></button>
        <button class="mobile-menu" aria-label="展开导航" aria-expanded="false">☰</button>
      </div>
    </header>
    <main id="main" class:list={[home ? "home-page" : "inner-page", {"journal-post":isPost}]}>
      {isPost ? <div class="journal-post-grid"><div class="journal-post-content"><a class="breadcrumb" href="/archive/">← 全部文章</a><slot /></div>{headings.length > 0 && <aside class="article-sidebar"><details open><summary>本文目录</summary><nav class="article-toc" aria-label="文章目录">{headings.filter(h=>h.depth<=3).map(h=><a class:list={{"toc-child":h.depth===3}} href={`#${h.slug}`}>{h.text}</a>)}</nav></details><a href="/archive/">← 返回文章列表</a></aside>}</div> : <slot />}
    </main>
    <footer data-pagefind-ignore><div><b>{siteConfig.title}</b><p>学习记录、研究项目与个人分享</p></div><a href="/about/">关于与联系 ↗</a><span>基于 <a href="https://github.com/LyraVoid/Mizuki" target="_blank" rel="noopener noreferrer">Mizuki</a> · <a href="/rss.xml">RSS</a></span></footer>
    <dialog id="search-dialog" aria-labelledby="search-title" data-pagefind-ignore><div class="dialog-toolbar"><h2 id="search-title">搜索站内内容</h2><button data-close aria-label="关闭搜索">关闭 ×</button></div><label class="search-label" for="search-input">输入标题、内容或关键词</label><input id="search-input" type="search" placeholder="例如：游戏、访谈、数据" autocomplete="off" /><div id="search-results" aria-live="polite"></div></dialog>
    <MusicPlayer client:idle />
    <FloatingControls headings={headings} />
    {pioConfig.enable && <Pio config={pioConfig} />}
    <script>
      import "../scripts/journal.js";
      import "../scripts/code-collapse.js";
      import { getFancyboxHandler } from "../scripts/handlers/fancybox-handler";
      void getFancyboxHandler().init();
    </script>
  </body>
</html>
