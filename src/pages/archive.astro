---
import JournalLayout from "@layouts/JournalLayout.astro";
import PostList from "@components/journal/PostList.astro";
import { getSortedPostsList } from "@utils/content-utils";
const posts=await getSortedPostsList();
const categories=[...new Set(posts.map(p=>p.data.category || "未分类"))];
const tags=[...new Set(posts.flatMap(p=>p.data.tags))];
---
<JournalLayout title="文章" description="课程论文、专题分析与访谈记录。">
  <div class="page-intro"><a class="breadcrumb" href="/">← 首页</a><h1>文章</h1><p>课程论文、专题分析与访谈记录。</p></div>
  <div data-collection data-unit="篇文章">
    <div class="filters" role="group" aria-label="筛选文章"><button data-category-filter="all" aria-pressed="true">全部</button>{categories.map(category=><button data-category-filter={category} aria-pressed="false">{category}</button>)}<span class="result-count" aria-live="polite">{posts.length} 篇文章</span></div>
    <label class="tag-selector">标签<select data-tag-filter aria-label="按标签筛选"><option value="">全部标签</option>{tags.map(tag=><option value={tag}>{tag}</option>)}</select></label>
    <PostList posts={posts} /><p data-filter-empty hidden>没有符合条件的文章。</p>
  </div>
</JournalLayout>
