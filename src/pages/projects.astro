---
import JournalLayout from "@layouts/JournalLayout.astro";
import ProjectList from "@components/journal/ProjectList.astro";
import { projectsData } from "@/data/projects";
import { siteConfig } from "@/config";
if (!siteConfig.featurePages.projects) return Astro.redirect("/404/");
const labels: Record<string,string>={web:"网站与网页游戏",mobile:"移动应用",desktop:"桌面应用",other:"研究与实践"};
const categories=[...new Set(projectsData.map(p=>p.category))];
---
<JournalLayout title="项目" description="用户研究、数据分析、课程实践与网页游戏。">
  <div class="page-intro"><a class="breadcrumb" href="/">← 首页</a><h1>项目</h1><p>用户研究、数据分析、课程实践与网页游戏。</p></div>
  <div data-collection data-unit="个项目"><div class="filters" role="group" aria-label="筛选项目"><button data-category-filter="all" aria-pressed="true">全部</button>{categories.map(category=><button data-category-filter={category} aria-pressed="false">{labels[category] || category}</button>)}<span class="result-count" aria-live="polite">{projectsData.length} 个项目</span></div><ProjectList projects={projectsData} /><p data-filter-empty hidden>没有符合条件的项目。</p></div>
</JournalLayout>
