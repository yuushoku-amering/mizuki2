---
import JournalLayout from "@layouts/JournalLayout.astro";
import PostList from "@components/journal/PostList.astro";
import ProjectList from "@components/journal/ProjectList.astro";
import { getSortedPostsList } from "@utils/content-utils";
import { projectsData } from "@/data/projects";
const posts=(await getSortedPostsList()).slice(0,2);
const ids=["vesper-research-workbench","melodyaiming","p2w-game-survey"];
const projects=ids.flatMap(id=>projectsData.filter(p=>p.id===id));
---
<JournalLayout home title="首页">
  <section class="a-hero"><img class="hero-image" src="/assets/journal/spring.webp" alt="阳光与黄花中的少女插画" fetchpriority="high" width="1800" height="1200" /><div class="hero-copy"><span class="eyebrow">優色雨铃 / 个人博客</span><h1>学习记录、研究项目<br />与<span>个人分享</span></h1><p>这里是吕家欣（優色雨铃）的个人博客。<br />收录社会学课程文章、用户研究与数据分析项目，<br />也记录游戏、音乐等兴趣，以及日常照片。</p><a class="primary-link" href="/archive/">浏览文章 <span>↗</span></a></div><span class="hero-caption">WORDS · RESEARCH · EVERYDAY LIFE</span></section>
  <section class="home-section"><div class="section-heading"><div><h2>最新文章</h2><p>社会学课程、访谈记录与专题思考</p></div><a class="text-link" href="/archive/">全部文章 ↗</a></div><PostList posts={posts} /></section>
  <section class="home-section"><div class="section-heading"><div><h2>精选项目</h2><p>用户研究、交互游戏与数据分析</p></div><a class="text-link" href="/projects/">全部项目 ↗</a></div><ProjectList projects={projects} /></section>
  <section class="home-section"><div class="section-heading"><div><h2>其他内容</h2><p>按栏目浏览博客内容</p></div></div><div class="directory-grid"><a href="/albums/"><strong>相册</strong><p>日常随拍与 ComfyUI 作品</p><span>查看相册 ↗</span></a><a href="/portfolio/"><strong>作品集</strong><p>研究案例与成果汇总</p><span>查看作品集 ↗</span></a><a href="/about/"><strong>关于我</strong><p>教育背景、个人介绍与联系方式</p><span>查看介绍 ↗</span></a></div></section>
</JournalLayout>
