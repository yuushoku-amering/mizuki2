---
import JournalLayout from "@layouts/JournalLayout.astro";
import {scanAlbums} from "@utils/album-scanner";
import {siteConfig} from "@/config";
if(!siteConfig.featurePages.albums)return Astro.redirect("/404/");
const albums=await scanAlbums();
const tags=[...new Set(albums.flatMap(album=>album.tags || []))];
---
<JournalLayout title="相册" description="按主题浏览日常照片与视觉作品。"><div class="page-intro"><a class="breadcrumb" href="/">← 首页</a><h1>相册</h1><p>按主题浏览日常照片与视觉作品。</p></div><div data-collection data-unit="个相册">{tags.length>0 && <label class="tag-selector">标签<select data-tag-filter aria-label="按标签筛选相册"><option value="">全部标签</option>{tags.map(tag=><option value={tag}>{tag}</option>)}</select></label>}<p class="result-count" aria-live="polite">{albums.length} 个相册</p><div class="album-list">{albums.map(album=><a class="album-card" data-filter-item data-category="all" data-tags={JSON.stringify(album.tags || [])} href={`/albums/${encodeURIComponent(album.id)}/`}><img src={album.cover} alt={`${album.title}相册封面`} loading="lazy" /><div><span class="eyebrow">{album.photos.length} 张照片 · {album.date}</span><h2>{album.title}</h2><p>{album.description}</p><span class="text-link">查看相册 ↗</span></div></a>)}</div><p data-filter-empty hidden>没有符合条件的相册。</p></div></JournalLayout>
