---
import type { GameItem } from "../../../utils/games-data";
import type { CategoryInfo } from "../../../utils/games-data";

interface Props {
	game: GameItem;
	categoryInfo: CategoryInfo;
	platformLabel: string;
	playtimeLabel: string;
	spendingLabel: string;
	proficientLabel: string;
	developerLabel: string;
	releaseDateLabel: string;
	experienceLabel: string;
}

const { game, categoryInfo, platformLabel, playtimeLabel, spendingLabel, proficientLabel, developerLabel, releaseDateLabel, experienceLabel } = Astro.props;
---

<div
	class="group relative bg-(--card-bg) border border-(--line-divider) rounded-(--radius-large) overflow-hidden hover:shadow-lg transition-all duration-200 hover:-translate-y-1"
	data-game-primary-category={game.primaryCategory}
		data-game-secondary-category={game.secondaryCategory}
	data-game-featured={game.isFeatured ? "true" : "false"}
>
	<div class="p-4">
		{/* 顶部：类型标签 + 精通标识 */}
		<div class="flex items-center justify-between mb-3">
			<span class={`px-2 py-0.5 rounded-md text-xs font-medium ${categoryInfo.class}`}>
				<span class="mr-1">{categoryInfo.icon}</span>
				<span>{categoryInfo.text}</span>
			</span>
			{
				game.isProficient && (
					<span class="px-2 py-0.5 rounded-md text-xs font-medium bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-300">
						⭐ {proficientLabel}
					</span>
				)
			}
		</div>

		{/* 游戏标题 + 评分 */}
		<div class="flex items-start justify-between mb-2">
			<h3 class="text-base font-bold text-black/90 dark:text-white/90 group-hover:text-(--primary) transition-colors">
				{game.title}
			</h3>
			<div class="flex items-center gap-1 shrink-0 ml-2">
				<svg class="w-3.5 h-3.5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
					<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
				</svg>
				<span class="text-sm font-semibold text-black/70 dark:text-white/70">{game.rating}</span>
			</div>
		</div>

		{/* 厂商 / 发行时间 */}
		<div class="flex items-center gap-3 text-xs text-black/55 dark:text-white/55 mb-3">
			<span class="flex items-center gap-1">
				<span class="opacity-60">{developerLabel}</span>
				<span class="font-medium text-black/70 dark:text-white/70">{game.developer}</span>
			</span>
			<span class="text-black/20 dark:text-white/20">|</span>
			<span class="flex items-center gap-1">
				<span class="opacity-60">{releaseDateLabel}</span>
				<span class="font-medium text-black/70 dark:text-white/70">{game.releaseDate}</span>
			</span>
		</div>

		{/* 标签：平台 */}
		<div class="flex items-center gap-1 mb-2 text-xs text-black/50 dark:text-white/50">
			<span class="shrink-0">{platformLabel}:</span>
			<div class="flex flex-wrap gap-1">
				{game.platform.map((p) => (
					<span class="px-1.5 py-0.5 bg-(--btn-regular-bg) text-black/70 dark:text-white/70 rounded text-xs">
						{p}
					</span>
				))}
			</div>
		</div>

		{/* 标签：类型 */}
		<div class="flex flex-wrap gap-1 mb-2">
			{game.genre.map((g) => (
				<span class="px-1.5 py-0.5 bg-(--btn-regular-bg) text-black/60 dark:text-white/60 rounded text-xs">
					{g}
				</span>
			))}
		</div>

		{/* 底部：时长 / 氪金 */}
		<div class="flex items-center gap-3 text-xs text-black/50 dark:text-white/50 pt-2 border-t border-(--line-divider)">
			{
				game.playtime && (
					<span class="flex items-center gap-1">
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						{playtimeLabel}: {game.playtime}h
					</span>
				)
			}
			{
				game.spending && (
					<span class="flex items-center gap-1">
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						{spendingLabel}: {game.spending}
					</span>
				)
			}
		</div>

		{
			game.experience && (
				<div class="mt-3 pt-3 border-t border-(--line-divider) text-xs leading-relaxed">
					<span class="font-medium text-(--primary)">{experienceLabel}：</span>
					<span class="text-black/60 dark:text-white/60">{game.experience}</span>
				</div>
			)
		}
	</div>
</div>
