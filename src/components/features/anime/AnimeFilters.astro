---
interface Props {
	filterAllLabel: string;
	typeAnimeLabel: string;
	typeMangaLabel: string;
	typeLightNovelLabel: string;
	typeNovelLabel: string;
}

const {
	filterAllLabel,
	typeAnimeLabel,
	typeMangaLabel,
	typeLightNovelLabel,
	typeNovelLabel,
} = Astro.props;
---

<div class="anime-filter-container flex flex-wrap gap-2">
	<button class="anime-filter-tag anime-active" data-status="all"
		>{filterAllLabel}</button
	>
	<button class="anime-filter-tag" data-status="anime"
		>{typeAnimeLabel}</button
	>
	<button class="anime-filter-tag" data-status="manga"
		>{typeMangaLabel}</button
	>
	<button class="anime-filter-tag" data-status="light_novel"
		>{typeLightNovelLabel}</button
	>
	<button class="anime-filter-tag" data-status="novel"
		>{typeNovelLabel}</button
	>
</div>
