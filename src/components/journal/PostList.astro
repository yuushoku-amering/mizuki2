---
import type { PostForList } from "@utils/content-utils";
import { getPostPublicDescription } from "@utils/post-card-content";
interface Props {posts: PostForList[];}
const {posts} = Astro.props;
---
<div class="post-list">
  {posts.map((post,index)=><article class="post-item" data-filter-item data-category={post.data.category || "未分类"} data-tags={JSON.stringify(post.data.tags)}>
    <span class="post-number">{String(index+1).padStart(2,"0")}</span>
    <div class="post-info"><div class="meta">{post.data.category || "未分类"} / <time datetime={post.data.published.toISOString()}>{post.data.published.toISOString().slice(0,10)}</time></div>
      <h3><a href={post.url}>{post.data.title}</a></h3>
      <p>{getPostPublicDescription(post.data)}</p><a class="text-link" href={post.url}>阅读全文 ↗</a>
    </div>
  </article>)}
</div>
